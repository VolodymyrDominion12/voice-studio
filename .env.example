# ── Шляхи ────────────────────────────────────────────────────────────────
# Куди складати завантаження, готове аудіо, семпли голосів.
# Якщо диск тісний — винести data/models на зовнішній носій і вказати тут.
VOICE_STUDIO_DATA_DIR=./data
VOICE_STUDIO_MODEL_DIR=./data/models

# ── TTS-шлюз (OpenAI-сумісний) ───────────────────────────────────────────
# Speaches: http://127.0.0.1:8001/v1  (docker) або http://tts:8000/v1 (compose)
TTS_BASE_URL=http://127.0.0.1:8001/v1
TTS_API_KEY=not-needed
# Рушій за замовчуванням: openai_compat | ukrainian_tts | piper | chatterbox
DEFAULT_ENGINE=openai_compat
DEFAULT_VOICE=uk_UA-tetiana-high
DEFAULT_EMOTION=neutral

# ── Синтез ───────────────────────────────────────────────────────────────
# Скільки сегментів синтезувати паралельно. Для CPU 2 — моделі й так
# займають ядра; більше дає конкуренцію за ті самі ресурси.
SYNTH_CONCURRENCY=2
# Цільова гучність. −18 LUFS — рівень аудіокниги, −16 — подкасту.
TARGET_LUFS=-18.0
TARGET_SAMPLE_RATE=24000
# Максимум символів у сегменті (перекривається рушієм через max_chars()).
SEGMENT_MAX_CHARS=300

# ── Пост-обробка ─────────────────────────────────────────────────────────
# Зсув тону — найризикованіша для артефактів операція. Типово вимкнено;
# керована просодія досягається темпом і паузами (див. ADR-004).
ENABLE_PITCH_SHIFT=false

# ── Ліміти завантаження ──────────────────────────────────────────────────
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=.txt,.md,.markdown,.pdf,.docx,.epub,.html,.htm

# ── Збірка аудіокниги ────────────────────────────────────────────────────
# Які файли створювати типово (кілька — через кому):
#   mp3 — слухається будь-де, найменший;
#   m4b — формат аудіокниги: розділи з заголовків + метадані (PyAV, без ffmpeg);
#   wav — без втрат, для монтажу (файл великий).
# У редакторі формати вибираються чекбоксами на кожне завдання окремо,
# а «zip по розділах» додає архів із файлом на кожен розділ.
OUTPUT_FORMATS=mp3
M4B_BITRATE_KBPS=64
MP3_BITRATE_KBPS=192
# Виконавець у тегах ID3/MP4 — плейер показує його як автора аудіокниги
AUDIOBOOK_ARTIST=Voice Studio

# ── Опційний зовнішній API (ет. 3, вимкнено за замовчуванням) ────────────
# Потрібен лише якщо треба справжня виразна українська сьогодні,
# поки немає відповідної відкритої моделі. Ключі не комітити.
REMOTE_TTS_ENABLED=false
REMOTE_TTS_BASE_URL=
REMOTE_TTS_API_KEY=
